{
  "meta": {
    "description": "Silver layer schema reference — canonical types, zero-padding rules, sentinel handling, and Neo4j edge relationships for all datasets.",
    "normalisation_rules": {
      "zero_padding": {
        "tract_fips": "zfill(11)",
        "fips_code": "zfill(11)",
        "county_fips": "zfill(5)",
        "zcta_code": "zfill(5)",
        "cbsa_code": "strip .0 float artifact, then zfill(5)",
        "state_fips": "zfill(2)",
        "state": "zfill(2)"
      },
      "sentinel_to_null": [
        {"value": "100000", "fields": ["cbsa_code"], "action": "None"},
        {"value": "100000.0", "fields": ["cbsa_code"], "action": "None"},
        {"value": "", "fields": ["all string fields"], "action": "None"},
        {"value": "nan", "fields": ["all string fields"], "action": "None"},
        {"value": "NA", "fields": ["all string fields"], "action": "None"},
        {"value": "None", "fields": ["all string fields"], "action": "None"}
      ],
      "boolean_fields": [
        "is_designated", "is_territory", "is_high_disparity",
        "is_multifamily_constrained", "income_estimate_reliable",
        "split_tr_flag", "is_metro_tract"
      ],
      "integer_fields": [
        "designation_year", "year", "basis_boost_pct",
        "ami_pct", "mfi_value", "state_mfi", "max_income",
        "limit_1person", "limit_2person", "limit_3person", "limit_4person",
        "limit_5person", "limit_6person", "limit_7person", "limit_8person",
        "total_applications", "total_originated", "total_denied",
        "multifamily_applications", "multifamily_denied",
        "area_population", "total_population", "population_in_qct", "effective_population",
        "VLIL4_current", "safmr_2br", "vlil_4person", "fmr_2br",
        "median_hh_income", "zcta_count_designated", "metro"
      ],
      "float_fields": [
        "poverty_rate_at_designation", "poverty_rate_vintage_minus1", "poverty_rate_vintage_minus2",
        "income_criterion_ratio", "income_criterion_ratio_minus1", "income_criterion_ratio_minus2",
        "poverty_rate_trend_3yr", "income_ratio_trend_3yr", "income_estimate_cv",
        "median_hh_income_moe", "ranking_ratio", "qct_overlap_pct",
        "lihtc_max_rent", "max_rent",
        "denial_rate_overall", "denial_rate_minority", "denial_rate_white",
        "multifamily_denial_rate", "denial_rate_disparity_ratio",
        "fair_lending_risk_score", "gse_sold_pct", "avg_loan_amount"
      ]
    }
  },
  "datasets": {
    "QCTDesignation": {
      "file_pattern": "silver/qct/silver_qct_{year}.parquet",
      "primary_key": "designation_id",
      "neo4j_label": "QCTDesignation",
      "neo4j_edge": {"rel": "APPLIES_TO", "via": "tract_fips", "target_label": "CensusTract", "target_pk": "fips_code"},
      "years": "2003-2025",
      "attributes": {
        "designation_id": {"type": "str", "description": "Unique key: {tract_fips}_{year}", "example": "01001020100_2025"},
        "source_pk": {"type": "str", "description": "Raw source primary key from HUD file (12-digit FIPS variant)", "example": "010010201000"},
        "tract_fips": {"type": "str", "padding": "zfill(11)", "description": "11-digit census tract FIPS code", "example": "01001020100"},
        "county_fips": {"type": "str", "padding": "zfill(5)", "description": "5-digit county FIPS code", "example": "01001"},
        "state_fips": {"type": "str", "padding": "zfill(2)", "description": "2-digit state FIPS code", "example": "01"},
        "cbsa_code": {"type": "str", "padding": "zfill(5)", "sentinel": "100000 → None", "description": "5-digit Core-Based Statistical Area code", "example": "33860"},
        "fmr_area_code": {"type": "str", "description": "HUD Fair Market Rent area code", "example": "METRO33860M33860"},
        "is_metro_tract": {"type": "bool", "description": "True if tract falls within a metropolitan FMR area"},
        "area_population": {"type": "Int64", "description": "Total population of the encompassing FMR area", "example": 386047},
        "split_tr_flag": {"type": "bool", "description": "True if tract spans multiple FMR areas"},
        "is_designated": {"type": "bool", "description": "True if officially designated as QCT this year"},
        "designation_year": {"type": "Int64", "description": "Year of the QCT designation", "example": 2025},
        "hud_notice_ref": {"type": "str", "description": "HUD Federal Register notice reference", "example": "Notice H 2025-01"},
        "basis_boost_pct": {"type": "Int64", "values": [0, 30], "description": "LIHTC basis boost percentage available to projects in the tract"},
        "qct_trigger_criterion": {"type": "str", "values": ["poverty_rate", "income_ratio", "none"], "description": "Which HUD criterion triggered designation"},
        "effective_date": {"type": "str", "format": "YYYY-MM-DD", "description": "Date the designation becomes effective", "example": "2025-01-01"},
        "poverty_rate_at_designation": {"type": "float64", "range": "0.0-1.0", "description": "Tract poverty rate used in the designation assessment"},
        "income_criterion_ratio": {"type": "float64", "description": "Ratio of tract median income to area VLIL threshold"},
        "median_hh_income": {"type": "float64", "description": "ACS tract median household income (dollars)", "example": 60563.0},
        "median_hh_income_moe": {"type": "float64", "description": "Margin of error on the median household income estimate"},
        "VLIL4_current": {"type": "Int64", "description": "Very Low Income Limit for 4-person household in the area", "example": 41581},
        "poverty_rate_vintage_minus1": {"type": "float64", "range": "0.0-1.0", "description": "Poverty rate from the prior ACS vintage year"},
        "poverty_rate_vintage_minus2": {"type": "float64", "range": "0.0-1.0", "description": "Poverty rate from two ACS vintage years prior"},
        "income_criterion_ratio_minus1": {"type": "float64", "description": "Income criterion ratio from the prior year"},
        "income_criterion_ratio_minus2": {"type": "float64", "description": "Income criterion ratio from two years prior"},
        "poverty_rate_trend_3yr": {"type": "float64", "description": "3-year change in poverty rate (current minus 2 years ago)"},
        "poverty_trend_direction": {"type": "str", "values": ["improving", "worsening", "stable"], "description": "Categorical label for poverty rate movement"},
        "income_ratio_trend_3yr": {"type": "float64", "description": "3-year change in the income criterion ratio"},
        "income_estimate_cv": {"type": "float64", "description": "Coefficient of variation for the income estimate (reliability indicator)"},
        "income_estimate_reliable": {"type": "bool", "description": "True if CV is below HUD reliability threshold"}
      }
    },
    "SDDADesignation_metro_area": {
      "file_pattern": "silver/dda/silver_dda_{year}_metro_area.parquet",
      "primary_key": "designation_id",
      "neo4j_label": "SDDADesignation",
      "neo4j_edge": {"rel": "APPLIES_TO", "via": "fmr_area_code", "target_label": "MetroArea", "target_pk": "fmr_area_code"},
      "years": "2003-2025",
      "notes": "Metro DDA aggregated to area level. Only is_designated=true rows are ingested.",
      "attributes": {
        "designation_id": {"type": "str", "description": "Unique key: {fmr_area_code}_{year}", "example": "METRO10380M10380_2025"},
        "fmr_area_code": {"type": "str", "description": "HUD FMR area code", "example": "METRO10380M10380"},
        "area_name": {"type": "str", "description": "Human-readable MSA name", "example": "Aguadilla-Isabela, PR MSA"},
        "is_designated": {"type": "bool", "description": "True if the metro area is designated as an SDDA"},
        "ranking_ratio": {"type": "float64", "description": "SAFMR-to-VLIL ratio used for DDA selection"},
        "safmr_2br": {"type": "Int64", "description": "Small Area Fair Market Rent for 2-bedroom unit (dollars)", "example": 620},
        "vlil_4person": {"type": "Int64", "description": "Very Low Income Limit for 4-person household", "example": 15150},
        "total_population": {"type": "Int64", "description": "Total metro population"},
        "population_in_qct": {"type": "Int64", "description": "Population residing in QCT-designated tracts"},
        "effective_population": {"type": "Int64", "description": "DDA-eligible population (total minus QCT overlap)"},
        "zcta_count_designated": {"type": "int64", "description": "Number of ZCTAs within the metro designated as DDAs"},
        "designation_year": {"type": "int64", "description": "Year of designation"},
        "basis_boost_pct": {"type": "int64", "values": [30], "description": "LIHTC basis boost percentage for designated areas"},
        "effective_date": {"type": "str", "format": "YYYY-MM-DD", "description": "Date the designation is effective"},
        "lihtc_max_rent": {"type": "float64", "description": "Maximum LIHTC rent = vlil_4person × 0.03"},
        "qct_overlap_pct": {"type": "float64", "range": "0.0-1.0", "description": "Share of metro population in a QCT"}
      }
    },
    "SDDADesignation_metro_zcta": {
      "file_pattern": "silver/dda/silver_dda_{year}_metro_zcta.parquet",
      "primary_key": "zcta_code",
      "neo4j_label": null,
      "neo4j_edge": null,
      "years": "2017-2025",
      "notes": "ZCTA-level detail. Aggregated to metro_area before Neo4j ingest. Only available 2017+.",
      "attributes": {
        "zcta_code": {"type": "str", "padding": "zfill(5)", "description": "5-digit ZIP Code Tabulation Area code"},
        "fmr_area_code": {"type": "str", "description": "HUD FMR area code for the containing metro"},
        "area_name": {"type": "str", "description": "HUD metro area name"},
        "is_designated": {"type": "bool", "description": "True if this ZCTA is designated as a DDA"},
        "ranking_ratio": {"type": "float64", "description": "SAFMR-to-VLIL ratio"},
        "safmr_2br": {"type": "int64", "description": "Small Area FMR for 2-bedroom unit (dollars)"},
        "vlil_4person": {"type": "int64", "description": "Very Low Income Limit for 4-person household"},
        "total_population": {"type": "Int64", "description": "ZCTA total population"},
        "population_in_qct": {"type": "Int64", "description": "ZCTA population in QCT tracts"},
        "effective_population": {"type": "Int64", "description": "DDA-eligible population"},
        "designation_year": {"type": "Int64", "description": "Year of designation"},
        "lihtc_max_rent": {"type": "float64", "description": "Maximum LIHTC rent = vlil_4person × 0.03"},
        "qct_overlap_pct": {"type": "float64", "range": "0.0-1.0", "description": "Share of ZCTA population in a QCT"},
        "is_territory": {"type": "bool", "description": "True if ZCTA is in a US territory (PR, GU, VI, AS, MP)"},
        "effective_date": {"type": "str", "format": "YYYY-MM-DD", "description": "Date the designation is effective"}
      }
    },
    "NMDDADesignation": {
      "file_pattern": "silver/dda/silver_dda_{year}_nonmetro_county.parquet",
      "primary_key": "designation_id",
      "neo4j_label": "NMDDADesignation",
      "neo4j_edge": {"rel": "APPLIES_TO", "via": "county_fips", "target_label": "County", "target_pk": "county_fips"},
      "years": "2003-2025",
      "notes": "Only is_designated=true rows are ingested. 10-49 rows per year (2003-2016) and ~1,974 rows (2017-2020) have county_fips=None due to unresolved area_name lookups — nodes ingested without APPLIES_TO edge.",
      "attributes": {
        "designation_id": {"type": "str", "description": "Unique key: {county_fips}_{year}", "example": "66010_2025"},
        "county_fips": {"type": "str", "padding": "zfill(5)", "nullable": true, "description": "5-digit county FIPS; None if area_name lookup failed"},
        "fmr_area_code": {"type": "str", "description": "HUD non-metro FMR area code", "example": "NCNTY66010N66010"},
        "area_name": {"type": "str", "description": "County or territory name as in HUD source"},
        "is_designated": {"type": "bool", "description": "True if designated as NMDDA"},
        "ranking_ratio": {"type": "float64", "description": "FMR-to-VLIL ratio for DDA selection"},
        "fmr_2br": {"type": "Int64", "description": "County-level FMR for 2-bedroom (non-metro uses county FMR, not SAFMR)"},
        "vlil_4person": {"type": "Int64", "description": "Very Low Income Limit for 4-person household"},
        "total_population": {"type": "Int64", "description": "Total county population"},
        "population_in_qct": {"type": "Int64", "description": "County population in QCT tracts"},
        "effective_population": {"type": "Int64", "description": "DDA-eligible population"},
        "designation_year": {"type": "Int64", "description": "Year of designation"},
        "basis_boost_pct": {"type": "Int64", "values": [30], "description": "LIHTC basis boost percentage"},
        "is_territory": {"type": "bool", "description": "True if county is in a US territory"},
        "effective_date": {"type": "str", "format": "YYYY-MM-DD", "description": "Date the designation is effective"},
        "lihtc_max_rent": {"type": "float64", "description": "Maximum LIHTC rent = vlil_4person × 0.03"},
        "qct_overlap_pct": {"type": "float64", "range": "0.0-1.0", "description": "Share of county population in a QCT"}
      }
    },
    "Section8AMILimit": {
      "file_pattern": "silver/ami/{year}/silver_section8_ami_limit_{year}.parquet",
      "primary_key": "limit_id",
      "neo4j_label": "Section8AMILimit",
      "neo4j_edge": {"rel": "HAS_MSA_AMI", "direction": "County → Section8AMILimit", "via": "silver_county_area_crosswalk_{year}.parquet", "match_field": "hud_fmr_area_code"},
      "years": "2010-2025",
      "attributes": {
        "limit_id": {"type": "str", "description": "Unique key: {hud_fmr_area_code}_{year}_{program_type}", "example": "METRO10180M10180_2025_ELI"},
        "hud_fmr_area_code": {"type": "str", "description": "HUD FMR area code (renamed from area_code in Fix 7)", "example": "METRO10180M10180"},
        "area_name": {"type": "str", "description": "Human-readable HUD area name", "example": "Abilene, TX MSA"},
        "state": {"type": "str", "padding": "zfill(2)", "description": "2-digit state FIPS code"},
        "program_type": {"type": "str", "values": ["ELI", "VLI", "LI"], "description": "Income tier: ELI=30% AMI, VLI=50% AMI, LI=80% AMI"},
        "mfi_value": {"type": "int64", "description": "Area Median Family Income used as the base", "example": 87300},
        "year": {"type": "int64", "description": "Limit effective year"},
        "ami_pct": {"type": "int64", "values": [30, 50, 80], "description": "Percentage of AMI this limit represents"},
        "limit_1person": {"type": "int64", "description": "Income limit for 1-person household (dollars)"},
        "limit_2person": {"type": "int64", "description": "Income limit for 2-person household (dollars)"},
        "limit_3person": {"type": "int64", "description": "Income limit for 3-person household (dollars)"},
        "limit_4person": {"type": "int64", "description": "Income limit for 4-person household (dollars)"},
        "limit_5person": {"type": "int64", "description": "Income limit for 5-person household (dollars)"},
        "limit_6person": {"type": "int64", "description": "Income limit for 6-person household (dollars)"},
        "limit_7person": {"type": "int64", "description": "Income limit for 7-person household (dollars)"},
        "limit_8person": {"type": "int64", "description": "Income limit for 8-person household (dollars)"},
        "max_income": {"type": "int64", "description": "Maximum qualifying income = limit_4person"},
        "max_rent": {"type": "float64", "nullable": true, "description": "Maximum allowable rent = limit_4person × 0.03; None except for VLI program_type"},
        "held_harmless": {"type": "object", "always_null": true, "description": "Reserved: HUD hold-harmless flag — None in current data"},
        "volatility_cap_applied": {"type": "object", "always_null": true, "description": "Reserved: HUD volatility cap flag — None in current data"},
        "uncapped_value": {"type": "object", "always_null": true, "description": "Reserved: raw pre-cap limit value — None in current data"}
      }
    },
    "SpecialProgramLimit": {
      "file_pattern": "silver/ami/{year}/silver_special_program_limit_{year}.parquet",
      "primary_key": "limit_id",
      "neo4j_label": "SpecialProgramLimit",
      "neo4j_edge": null,
      "years": "2010-2025",
      "notes": "Same schema as Section8AMILimit except program_type values and ami_pct/max_rent are always None.",
      "attributes": {
        "limit_id": {"type": "str", "description": "Unique key: {hud_fmr_area_code}_{year}_{program_type}", "example": "METRO10180M10180_2025_SEC221_BMIR"},
        "hud_fmr_area_code": {"type": "str", "description": "HUD FMR area code"},
        "area_name": {"type": "str", "description": "Human-readable HUD area name"},
        "state": {"type": "str", "padding": "zfill(2)", "description": "2-digit state FIPS code"},
        "program_type": {"type": "str", "values": ["SEC221_BMIR", "SEC235", "SEC236"], "description": "Special HUD program identifier"},
        "mfi_value": {"type": "int64", "description": "Area Median Family Income used as base"},
        "year": {"type": "int64", "description": "Limit effective year"},
        "ami_pct": {"type": "object", "always_null": true, "description": "Always None — special programs are not a simple % of AMI"},
        "limit_1person": {"type": "int64", "description": "Income limit for 1-person household (dollars)"},
        "limit_2person": {"type": "int64", "description": "Income limit for 2-person household (dollars)"},
        "limit_3person": {"type": "int64", "description": "Income limit for 3-person household (dollars)"},
        "limit_4person": {"type": "int64", "description": "Income limit for 4-person household (dollars)"},
        "limit_5person": {"type": "int64", "description": "Income limit for 5-person household (dollars)"},
        "limit_6person": {"type": "int64", "description": "Income limit for 6-person household (dollars)"},
        "limit_7person": {"type": "int64", "description": "Income limit for 7-person household (dollars)"},
        "limit_8person": {"type": "int64", "description": "Income limit for 8-person household (dollars)"},
        "max_income": {"type": "int64", "description": "Maximum qualifying income = limit_4person"},
        "max_rent": {"type": "object", "always_null": true, "description": "Always None — max rent not applicable to special programs"},
        "held_harmless": {"type": "object", "always_null": true, "description": "Reserved — None in current data"},
        "volatility_cap_applied": {"type": "object", "always_null": true, "description": "Reserved — None in current data"},
        "uncapped_value": {"type": "object", "always_null": true, "description": "Reserved — None in current data"}
      }
    },
    "StateAMILimit": {
      "file_pattern": "silver/ami/{year}/silver_state_ami_limit_{year}.parquet",
      "primary_key": "limit_id",
      "neo4j_label": "StateAMILimit",
      "neo4j_edge": {"rel": "APPLIES_TO", "via": "state", "target_label": "State", "target_pk": "state_fips"},
      "years": "2010-2025",
      "attributes": {
        "limit_id": {"type": "str", "description": "Unique key: {state_fips}_{year}_{program_type}", "example": "01_2025_ELI"},
        "state": {"type": "str", "padding": "zfill(2)", "description": "2-digit state FIPS code"},
        "program_type": {"type": "str", "values": ["ELI", "VLI", "LI"], "description": "Income tier: ELI=30%, VLI=50%, LI=80%"},
        "state_mfi": {"type": "int64", "description": "State-level Median Family Income", "example": 86400},
        "year": {"type": "int64", "description": "Limit effective year"},
        "ami_pct": {"type": "int64", "values": [30, 50, 80], "description": "Percentage of AMI this limit represents"},
        "limit_1person": {"type": "int64", "description": "State income limit for 1-person household (dollars)"},
        "limit_2person": {"type": "int64", "description": "State income limit for 2-person household (dollars)"},
        "limit_3person": {"type": "int64", "description": "State income limit for 3-person household (dollars)"},
        "limit_4person": {"type": "int64", "description": "State income limit for 4-person household (dollars)"},
        "limit_5person": {"type": "int64", "description": "State income limit for 5-person household (dollars)"},
        "limit_6person": {"type": "int64", "description": "State income limit for 6-person household (dollars)"},
        "limit_7person": {"type": "int64", "description": "State income limit for 7-person household (dollars)"},
        "limit_8person": {"type": "int64", "description": "State income limit for 8-person household (dollars)"},
        "max_income": {"type": "int64", "description": "Maximum qualifying income = limit_4person"},
        "max_rent": {"type": "float64", "nullable": true, "description": "Max rent = limit_4person × 0.03; None for ELI program_type"},
        "held_harmless": {"type": "object", "always_null": true, "description": "Reserved — None in current data"},
        "volatility_cap_applied": {"type": "object", "always_null": true, "description": "Reserved — None in current data"},
        "uncapped_value": {"type": "object", "always_null": true, "description": "Reserved — None in current data"}
      }
    },
    "CountyAreaCrosswalk": {
      "file_pattern": "silver/ami/{year}/silver_county_area_crosswalk_{year}.parquet",
      "primary_key": null,
      "neo4j_label": null,
      "neo4j_edge": null,
      "years": "2010-2025",
      "notes": "Internal file only. Used by ingest_datasets.py to create HAS_MSA_AMI and HAS_STATE_AMI edges between County and Section8AMILimit nodes.",
      "attributes": {
        "fips": {"type": "str", "description": "10-digit county FIPS (state + county + 99999 suffix for non-metro rows)"},
        "state": {"type": "str", "padding": "zfill(2)", "description": "2-digit state FIPS code"},
        "county": {"type": "str", "description": "3-digit county FIPS code"},
        "hud_area_code": {"type": "str", "description": "HUD FMR area code — matched against Section8AMILimit.hud_fmr_area_code to create HAS_MSA_AMI edges"},
        "hud_area_name": {"type": "str", "description": "Human-readable HUD area name"},
        "metro": {"type": "int64", "values": [0, 1], "description": "1 = metropolitan county, 0 = non-metropolitan"},
        "year": {"type": "int64", "description": "Reference year for the crosswalk"}
      }
    },
    "LenderBehaviorRisk": {
      "file_pattern": "silver/hmda/{year}/silver_lender_behavior_risk_{year}.parquet",
      "primary_key": "risk_id",
      "neo4j_label": "LenderBehaviorRisk",
      "neo4j_edge": {"rel": "APPLIES_TO", "via": "cbsa_code", "target_label": "MetroArea", "target_pk": "cbsa_code"},
      "years": "2022-2025",
      "notes": "~1,300-1,320 rows per year have cbsa_code=None (rural counties with no CBSA). These are ingested as nodes without APPLIES_TO edge. Aggregated to one row per (cbsa_code, assessment_year) taking the Metropolitan Division with highest total_applications (Fix 5).",
      "attributes": {
        "risk_id": {"type": "str", "description": "Unique key: {cbsa_code}_{assessment_year}", "example": "10100_2025"},
        "cbsa_code": {"type": "str", "padding": "zfill(5)", "nullable": true, "description": "5-digit CBSA code; None for rural county rows with no CBSA affiliation"},
        "assessment_year": {"type": "str", "neo4j_stored_as": "STRING", "description": "HMDA assessment year -- stored as STRING in Neo4j, compare with toString($year) or '2025'", "example": "2025"},
        "msa_code": {"type": "str", "description": "Source county FIPS used as MSA proxy during aggregation"},
        "total_applications": {"type": "int64", "description": "Total mortgage applications (originated + denied)"},
        "total_originated": {"type": "int64", "description": "Total loans originated"},
        "total_denied": {"type": "int64", "description": "Total loans denied"},
        "multifamily_applications": {"type": "int64", "description": "Applications for 5+ unit multifamily properties"},
        "multifamily_denied": {"type": "int64", "description": "Multifamily applications denied"},
        "lender_count": {"type": "object", "always_null": true, "description": "Distinct lender count — currently None (requires Panel file with topholder RSSD mapping)"},
        "avg_loan_amount": {"type": "float64", "description": "Average origination loan amount (dollars)"},
        "gse_sold_pct": {"type": "float64", "range": "0.0-1.0", "description": "Share of originated loans sold to Fannie Mae or Freddie Mac"},
